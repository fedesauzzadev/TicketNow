{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "queue-route": {
        "ClusterId": "queue",
        "Match": { "Path": "/api/queue/{**catch-all}" },
        "Order": 100
      },
      "hubs-route": {
        "ClusterId": "queue",
        "Match": { "Path": "/hubs/{**catch-all}" },
        "Order": 100,
        "Transforms": [ { "RequestHeadersCopy": "true" } ]
      },
      "events-route": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/events/{**catch-all}" },
        "Order": 100
      },
      "admin-route": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/admin/{**catch-all}" },
        "Order": 100
      },
      "inventory-route": {
        "ClusterId": "inventory",
        "Match": { "Path": "/api/inventory/{**catch-all}" },
        "Order": 100,
        "AuthorizationPolicy": "purchase"
      },
      "inventory-admin-route": {
        "ClusterId": "inventory",
        "Match": { "Path": "/api/inventory/admin/{**catch-all}" },
        "Order": 50
      },
      "inventory-ping-route": {
        "ClusterId": "inventory",
        "Match": { "Path": "/api/inventory/ping" },
        "Order": 50
      },
      "orders-route": {
        "ClusterId": "orders",
        "Match": { "Path": "/api/orders/{**catch-all}" },
        "Order": 100,
        "AuthorizationPolicy": "purchase"
      },
      "orders-ping-route": {
        "ClusterId": "orders",
        "Match": { "Path": "/api/orders/ping" },
        "Order": 50
      },
      "payments-route": {
        "ClusterId": "orders",
        "Match": { "Path": "/api/payments/{**catch-all}" },
        "Order": 100,
        "AuthorizationPolicy": "purchase"
      },
      "payments-ping-route": {
        "ClusterId": "orders",
        "Match": { "Path": "/api/payments/ping" },
        "Order": 50
      },
      "payments-captcha-route": {
        "ClusterId": "orders",
        "Match": { "Path": "/api/payments/captcha" },
        "Order": 50
      },
      "tickets-route": {
        "ClusterId": "orders",
        "Match": { "Path": "/api/tickets/{**catch-all}" },
        "Order": 100,
        "AuthorizationPolicy": "purchase"
      },
      "tickets-ping-route": {
        "ClusterId": "orders",
        "Match": { "Path": "/api/tickets/ping" },
        "Order": 50
      }
    },
    "Clusters": {
      "queue": {
        "Destinations": { "d1": { "Address": "http://queue-service:8080" } }
      },
      "catalog": {
        "Destinations": { "d1": { "Address": "http://catalog-service:8080" } }
      },
      "inventory": {
        "Destinations": { "d1": { "Address": "http://inventory-service:8080" } }
      },
      "orders": {
        "Destinations": { "d1": { "Address": "http://orders-service:8080" } }
      }
    }
  },
  "Gateway": {
    "Health": {
      "Targets": [
        "http://queue-service:8080/health/live",
        "http://catalog-service:8080/health/live",
        "http://inventory-service:8080/health/live",
        "http://orders-service:8080/health/live"
      ]
    }
  },
  "Queue": {
    "AdmissionSigningKey": "dev-queue-key-no-usar-en-produccion-rotar-via-env-32b"
  },
  "Auth": {
    "UserSigningKey": "dev-user-key-no-usar-en-produccion-rotar-via-env-32b0"
  }
}
