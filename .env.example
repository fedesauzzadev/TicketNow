# TicketNow — variables de entorno para desarrollo local.
# Copiar a .env y ajustar. NUNCA commitear .env (está en .gitignore).

# Puertos host (por defecto evitamos los clásicos para no chocar con servicios locales)
EDGE_PORT=8090
POSTGRES_PORT=5435
REDIS_PORT=6382
RABBITMQ_PORT=5673
RABBITMQ_MGMT_PORT=15673
GRAFANA_PORT=3001

# Clave de firma de admission tokens (Fase 4). DEBE coincidir en gateway y
# queue-service y tener >= 32 caracteres. Rotar como las demás claves (docs/06 §7).
QUEUE_ADMISSION_KEY=dev-queue-key-no-usar-en-produccion-rotar-via-env-32b

# Clave de firma de JWT de usuario (Fase 6, solo gateway). Mock didáctico:
# en producción la emite un IdP. Rotar igual (docs/06 §7).
AUTH_USER_KEY=dev-user-key-no-usar-en-produccion-rotar-via-env-32b0

POSTGRES_PASSWORD=ticketnow
RABBITMQ_PASSWORD=ticketnow
GRAFANA_PASSWORD=admin

# Traces (Jaeger). Dejar vacío para silenciar el export de OTel
# cuando no se corre el profile "obs" (p.ej.: OTEL_EXPORTER_OTLP_ENDPOINT=)
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
